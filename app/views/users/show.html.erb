
<% if @user.cover_picture.present? %>
  <%= image_tag @user.cover_picture.variant(resize_to_fill: [1366, 300]), style: "width: 95vw; max-height: 400px; object-fit: cover;" %>
<% end %>

<%= image_tag @user.profile_picture.variant(resize_to_limit: [150, 150]) %>

<h2>
  <%= @user.first_name + " " + @user.last_name%>
</h2>

<div>
  <p><%= @user.bio %></p>
</div>

<% if @user == current_user %>
  <div>
    <%= link_to "Edit Account Information", edit_user_registration_path(@user) %>
  </div>
<% elsif current_user != @user %>
  <%= turbo_stream_from "user_#{@user.id}_follows" %>
  <div id="follow_button">
    <%= render 'follows/follow_button', user: @user %>
  </div>
<% end %>

<div>
  <h1><%= @user.last_name + "'s " + "Post".pluralize(@user.posts.count)%></h3>
  <% @user.posts.each do |post| %>
    <%= render "posts/post", post: post%>
    <hr>
  <% end %>
</div>
