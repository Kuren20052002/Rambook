<div>
  <a href="<%= user_path(post.user)%>">
    <h3><%= post.user.first_name + " " + post.user.last_name%></h3>
  </a>
  
  <a href="<%= post_path(post) %>">
    <% if post.body.present? %>
      <p><%= simple_format(post.body) %></p>
    <% end %>
    
    <% if post.image.present? %>
      <%= image_tag post.image.variant(resize_to_limit: [800, 800]) %>
    <% end %>
  </a>

  <%= turbo_stream_from "post_#{post.id}_heart" %>
  <div id="heart_button_<%= post.id %>">
    <%= render 'hearts/heart_count_and_button', heartable: post %>
  </div>

  <br><%= link_to "Comments", post_path(post)%>
  <% if current_user == post.user %>
    <br><%= link_to "Edit", edit_post_path(post)%>
    <br><%= link_to "Delete", post_path(post), data: { turbo_method: :delete }%>
  <% end %>
</div>

